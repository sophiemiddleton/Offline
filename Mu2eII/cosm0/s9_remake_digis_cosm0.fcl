# -*- mode: tcl -*-
#------------------------------------------------------------------------------
# read digi file, remake CRV digis with a given gain, reconstruct, stntuple 
# 
# by default: write reconstructed output (DST), set physics.out to [] if not needed
# stntuple_p40 includes full CRV reco
# S9: reprocessing of S8 with remaking all digis and only one (cosmic) time map
#------------------------------------------------------------------------------
BEGIN_PROLOG
  INPUT_MODULE  @protect_ignore: RootInput      # EmptyEvent/RootInput
  TRIGGER_PATHS @protect_ignore: [ remake_digis ]

  PROCESS_NAME  @protect_ignore: S9RemakeDigis
  GEN_ID        @protect_ignore: "cosmicCRY"
  TIME_MAPS     @protect_ignore: [ "compressDigiMCs:cosmicTimeMap" ]
END_PROLOG

#include "Stntuple/fcl/stnmaker.fcl"

process_name                              : @local::PROCESS_NAME

source.inputCommands                      : [ "keep *", 
					      "drop *_*_*_GenSimDigi"                        , 
					      "drop *_*_*_S*RecoStn"                         ,

					      "drop  mu2e::CrvDigis_CrvDigi_*_*"             ,
					      "drop  mu2e::CrvDigiMCs_compressDigiMCs_*_*"   ,

					      "drop  mu2e::StrawDigis_makeSD_*_*"            ,
					      "drop  mu2e::StrawDigiMCs_compressDigiMCs_*_*" ,

					      "drop  mu2e::CaloDigis_CaloDigiFromShower_*_*"     ,
					      "drop  mu2e::CaloShowerStepROs_compressDigiMCs_*_*" 
					     ]
outputs : { @table::Stntuple.outputs }
physics : { @table::Stntuple.physics }    # note Stntuple.physics, not Mu2eII.physics

physics.remake_digis                      : [ 
					     makeSD , 
					     SeparateCaloShowerSteps, CaloShowerStepROFromShowerStep, CaloDigiFromShower, 
					     @sequence::CrvDAQPackage.CrvDAQSequence 
					    ]

physics.producers.makeSD.StrawGasStepModule                              : "compressDigiMCs"
# if calorimeterRO (SiPMs) collection is fed into CaloShowerStepROFromShowerStep, it crashes
physics.producers.CaloShowerStepROFromShowerStep.caloCrystalShowerInputs : [ "SeparateCaloShowerSteps:calorimeter" ] # , "SeparateCaloShowerSteps:calorimeterRO" ]

physics.output_path                       : [ defaultOutput            ]    # choices: [ ] / [ defaultOutput ]
#------------------------------------------------------------------------------
# cosmic datasets does't have "compressDigiMCs:protonabsorber"
physics.producers.compressRecoMCs.extraStepPointMCTags : [ "compressDigiMCs:virtualdetector" ]
#------------------------------------------------------------------------------
# fill both CRV blocks
physics.filters.StntupleMakerDeDmu.makeCrvPulses       : 1

outputs.defaultOutput.SelectEvents        : [ @sequence::TRIGGER_PATHS ]
#------------------------------------------------------------------------------
# services.message.destinations.log.categories.ArtSummary.limit      : 0    # exponential ?
services.message.destinations.log.categories.ArtReport.limit       : 10000  # number of events 

services.GeometryService.inputFile        : "Mu2eII/common/geom_baseline.txt"
services.TFileService.fileName            : "nts._USER_.cosm0s90b0.Mu2eII.001000_00000000.root"
outputs.defaultOutput.fileName            : "dig._USER_.cosm0s91b0.Mu2eII.001000_00000000.art"
#------------------------------------------------------------------------------
