# -*- mode: tcl -*-
#------------------------------------------------------------------------------
# conversion electrons: read digi file, reconstruct hits 
#------------------------------------------------------------------------------
BEGIN_PROLOG
  INPUT_MODULE  @protect_ignore: RootInput      # EmptyEvent/RootInput
  TRIGGER_PATHS @protect_ignore: [ p1 ]

  PROCESS_NAME  @protect_ignore: RecoStn
  GEN_ID        @protect_ignore: "unknown"
END_PROLOG

#include "JobConfig/common/Mu2eII.fcl"

process_name                              : @local::PROCESS_NAME

physics                                   : { @table::Mu2eII.physics }  # note Stntuple.physics, not Mu2eII.physics

physics.p1                                : [ @sequence::Mu2eII.trk_hit_reco ]

physics.output_path                       : [ defaultOutput            ]  # choices: [ ] / [ defaultOutput ]
outputs.defaultOutput.SelectEvents        : [ @sequence::TRIGGER_PATHS ]
#------------------------------------------------------------------------------
services.GeometryService.inputFile        : "Mu2eII/common/geom_baseline.txt"
services.TFileService.fileName            : "nts.user.trk_hit_reco.Mu2eII.001000_00000000.root"
outputs.defaultOutput.fileName            : "mcs.user.trk_hit_reco.Mu2eII.001000_00000000.art"

#include "gen/fcl/Trigger/offline/allTrig/allPaths.fcl"
