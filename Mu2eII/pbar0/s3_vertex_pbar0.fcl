# -*- mode:tcl -*- 
# trace pbars (and pi-'s) from TS3u through TS3 coll's up to TS5
#------------------------------------------------------------------------------
#include "Filters/fcl/prolog.fcl"
#include "JobConfig/beam/TS.fcl"

# Give this job a name.
process_name : pbars3

source : { 
    module_type : RootInput 
}

physics: { @table::physics
    trigFilter    : [ g4run, g4filter ]
    trigger_paths : [ trigFilter      ]
    
    e1            : [ filteredOutput, readAntiProtonSteps, readDelayedRPCSteps, genCountLogger ]
    end_paths     : [ e1 ]
}

# Energy cuts on electron, positron, photon, and neutron.
CutEPPhN : {
    type : intersection
    pars : [ { type: kineticEnergy cut: 100.0 },
             { type: pdgId pars: [ 11, -11, 22, 2112 ] } ]
}

physics.producers.g4run.Mu2eG4CommonCut : {
    type : union
    pars : [ @local::CutEPPhN,
	     { type: inVolume     pars: [ HallAir ] },
	     { type: intersection pars: 
		 [
		  { type : inVolume pars: [TS5Vacuum, DS1Vacuum, DS2Vacuum, DS3Vacuum ] },
		  { type : pdgId    pars: [ -2212 , -211]                               }
		 ]
		 write : DSVacuum
	     }
	    ] 
}
#------------------------------------------------------------------------------
#  ntuple makers
#------------------------------------------------------------------------------
physics.analyzers.readAntiProtonSteps : {
    module_type          : MyReadAntiProtonSteps
    savePDG              : [-2212]
    psVacuumStepPoints	 : "DSVacuum"
    generatorModuleLabel : "resamplingMixer"
    g4ModuleLabel	 : "g4filter"
    diagLevel 	         : 0
    stage                : 3
}

physics.analyzers.readDelayedRPCSteps : {
    module_type          : MyReadAntiProtonSteps
    savePDG              : [-211]
    psVacuumStepPoints	 : "DSVacuum"
    generatorModuleLabel : "resamplingMixer"
    g4ModuleLabel	 : "g4filter"
    diagLevel 	         : 0
    stage                : 3
}
#------------------------------------------------------------------------------
# 
#------------------------------------------------------------------------------
services.GeometryService.inputFile       : "Mu2eII/common/geom_baseline.txt" 
services.TFileService.fileName           : "nts.owner.pbar0s30b0.Mu2eII.sequencer.root"
#------------------------------------------------------------------------------
# 
#------------------------------------------------------------------------------
physics.producers.g4run.MultiStageParameters.simParticleNumberOffset    : 300000  
physics.producers.g4run.MultiStageParameters.inputSimParticles          :   "g4filter"
physics.producers.g4run.MultiStageParameters.genInputHits               : [ "g4filter:Coll31OutRecord" ]
physics.producers.g4run.MultiStageParameters.inputPhysVolumeMultiInfo   : ""             # was "compressPV"

physics.producers.g4run.SDConfig.enableSD                               : [ virtualdetector            ]
physics.producers.g4run.SDConfig.preSimulatedHits                       : [ "g4filter:virtualdetector" ]

physics.filters.g4filter.mainHitInputs  : [ "g4run:DSVacuum"        ]       # end of tracing
physics.filters.g4filter.extraHitInputs : [ "g4run:virtualdetector" ]

outputs : {
    filteredOutput     : {
	module_type    : RootOutput
	SelectEvents   : ["trigFilter"]
	outputCommands : [ "drop *_*_*_*",
                           "keep mu2e::GenParticles_*_*_*",
                           "keep mu2e::GenEventCount_*_*_*",
                           "keep mu2e::StatusG4_*_*_*",
                           "keep mu2e::StepPointMCs_g4filter_*_pbars3", 
                           "keep mu2e::SimParticlemv_g4filter_*_pbars3"
			  ]
	fileName       : "sim.owner.pbar0s31b0.Mu2eII.sequencer.art"
    }
}

