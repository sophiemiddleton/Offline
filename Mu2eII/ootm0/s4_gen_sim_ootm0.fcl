# -*- mode: tcl -*-
#------------------------------------------------------------------------------
# DIO electrons, full spectrum : StepPointMC's for mixing 
#------------------------------------------------------------------------------
BEGIN_PROLOG
  TRIGGER_PATHS @protect_ignore: [ Mu2eII_p14_mustop ]               # defined in Mu2eII/common/Mu2eII.fcl
  GEN_ID        @protect_ignore: StoppedParticleReactionGun
END_PROLOG

#include "JobConfig/common/Mu2eII.fcl"

process_name : S4GenSim
source       : { module_type: EmptyEvent }     # choices: EmptyEvent / RootInput
outputs      : { @table::Mu2eII.outputs  }

physics      : { @table::Mu2eII.physics  }

physics.producers.generate                : { @table::Mu2eII.physics.producers.ootMuonGun }
physics.producers.g4run.TrajectoryControl : { produce : false }

physics.output_path                       : [ defaultOutput ]
outputs.defaultOutput.SelectEvents        : [ @sequence::TRIGGER_PATHS ]
outputs.defaultOutput.outputCommands      : [ @sequence::Mu2eII.gen_sim_output ]
#------------------------------------------------------------------------------
services.GeometryService.inputFile        : "Mu2eII/common/geom_baseline.txt"
services.TFileService.fileName            : "nts._USER_.ootm0s41b0.Mu2eII.001000_00000000.root"
outputs.defaultOutput.fileName            : "sim._USER_.ootm0s41b0.Mu2eII.001000_00000000.art"
