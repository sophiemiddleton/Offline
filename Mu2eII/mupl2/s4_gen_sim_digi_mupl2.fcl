# -*- mode: tcl -*-

BEGIN_PROLOG
  INPUT_MODULE  @protect_ignore: EmptyEvent                 # choices: EmptyEvent / RootInput
  TRIGGER_PATHS @protect_ignore: [ Mu2eII_p1 ]              # defined in Mu2eII/common/Mu2eII.fcl
  PROCESS_NAME  @protect_ignore: GenSimDigi
  GEN_ID        @protect_ignore: StoppedParticleReactionGun # or 28
END_PROLOG

#include "JobConfig/common/Mu2eII.fcl"

process_name                            : @local::PROCESS_NAME

source                                  : { module_type: @local::INPUT_MODULE }
physics                                 : { @table::Mu2eII.physics }

physics.producers.generate               : { @table::Mu2eII.physics.producers.MichelPositronGun }
physics.filters.StrawDigiMCFilter.MinParticleMom : 10
#physics.producers.generate.physics.pdgId : -13                                       # mu+

physics.output_path                     : [ defaultOutput ]
outputs.defaultOutput.SelectEvents      : [ @sequence::TRIGGER_PATHS ]
outputs.defaultOutput.outputCommands    : [ @sequence::Mu2eII.gen_sim_digi_output ]
#------------------------------------------------------------------------------
services.GeometryService.inputFile      : "Mu2eII/mupl2/geom_Mu2eII_mupl2.txt"
services.TFileService.fileName          : "nts._USER_.mupl2s41b0.Mu2eII.001000_00000000.root"
outputs.defaultOutput.fileName          : "dig._USER_.mupl2s41b0.Mu2eII.001000_00000000.art"
