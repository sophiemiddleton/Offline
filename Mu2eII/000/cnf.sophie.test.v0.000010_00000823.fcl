services.TFileService.fileName: "nts.MU2EGRIDDSOWNER.TS.MU2EGRIDDSCONF.000010_00000823.root"
outputs.crvout.fileName : "sim.MU2EGRIDDSOWNER.TS-crv.MU2EGRIDDSCONF.000010_00000823.art"
outputs.mubeamout.fileName : "sim.MU2EGRIDDSOWNER.TS-Mu2e2.MU2EGRIDDSCONF.000010_00000823.art"
outputs.truncatedEvtsOutput.fileName : "sim.MU2EGRIDDSOWNER.TS-truncated.MU2EGRIDDSCONF.000010_00000823.art"
