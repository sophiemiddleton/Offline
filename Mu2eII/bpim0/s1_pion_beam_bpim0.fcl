# -*- mode: tcl -*-
#------------------------------------------------------------------------------
# this FCL file is used to produce stopped muon ntuple
# trace only pions and muons , but not electrons and photons below 100 MeV - it is a matter of saving time
#------------------------------------------------------------------------------
#include "JobConfig/beam/PS.fcl"

// Energy cuts on electrons, positrons, photons, and neutrons.

CutEPPhN : {
    type : intersection
    pars : [ { type: kineticEnergy cut: 100.0 },
             { type: pdgId pars: [ 11, -11, 22, 2112 ] } ]
}

physics.producers.g4run.Mu2eG4CommonCut : {
    type : union
    pars : [
	    @local::CutEPPhN,
	    @local::dsRegionCuts,
	    @local::extMonRegionCuts
	   ]
}

physics.outputs: [ mubeamout ]
#------------------------------------------------------------------------------
services.GeometryService.inputFile      : "Mu2eII/common/geom_baseline.txt"
services.scheduler.wantSummary          : true

physics.producers.g4run.physics.noDecay : [ 211, -211 ]

services.TFileService.fileName          : "nts.owner.bpim0s10b0.Mu2eII.sequencer.root"
outputs.mubeamout.fileName              : "sim.owner.bpim0s11b0.Mu2eII.sequencer.art"
