# -*- mode: tcl -*-
#include "JobConfig/beam/TS.fcl"

// Energy cuts on electrons, positrons, photons, and neutrons.

CutEPPhN : {
    type : intersection
    pars : [ { type: kineticEnergy cut: 100.0 },
             { type: pdgId pars: [ 11, -11, 22, 2112 ] } ]
}

physics.producers.g4run.Mu2eG4CommonCut : {
    type : union
    pars : [
    	    @local::CutEPPhN,
	    {
		type: inVolume
		pars: [TS5Vacuum, DS1Vacuum, DS2Vacuum, DS3Vacuum ]
		write: DSVacuum
	    }
	   ]
}
physics.outputs : [ mubeamout ]
#------------------------------------------------------------------------------
outputs.mubeamout.outputCommands: [
			 "drop *_*_*_*",
			                                       # GenParticles and GenEventCount are produced by the s1
			                                       # don't care about the s1 process name
                                                               # keep G4 status from all stages
			 "keep mu2e::GenParticles_*_*_*",
			 "keep mu2e::GenEventCount_*_*_*",
			 "keep mu2e::StatusG4_*_*_*",
                                                               # keep StepPointMC collections produced by the output filters 
                                                               # at previous stages

			 "keep  mu2e::StepPointMCs_muonBeamFilter_mubeam_*",

                                                               # keep all SimParticles and StepPointMC collections produced
			                                       # by muonBeamFilter in the current process (TS)

			 "keep mu2e::SimParticlemv_muonBeamFilter_*_TS",
			 "keep mu2e::StepPointMCs_muonBeamFilter_*_TS",

			                                       # don't know why, but this is needed
			 "keep *_compressPVmuonBeam_*_TS"
			]
#------------------------------------------------------------------------------
services.GeometryService.inputFile      : "Mu2eII/common/geom_baseline.txt"
services.scheduler.wantSummary          : true
physics.producers.g4run.physics.noDecay : [ 211, -211 ]

services.TFileService.fileName          : "nts.owner.bpim0s20b0.Mu2eII.sequencer.root"
outputs.mubeamout.fileName              : "sim.owner.bpim0s21b0.Mu2eII.sequencer.art"
