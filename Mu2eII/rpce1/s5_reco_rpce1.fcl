# -*- mode: tcl -*-

BEGIN_PROLOG
  INPUT_MODULE @protect_ignore: RootInput    # choices: EmptyEvent/RootInput
  TRIGGER_PATH @protect_ignore: Mu2eII_p2    # defined in Mu2eII/common/templates.fcl
  PROCESS_NAME @protect_ignore: Reco
  GEN_ID       @protect_ignore: InternalRPC
END_PROLOG

#include "JobConfig/common/Mu2eII.fcl"

process_name                            : @local::PROCESS_NAME

source                                  : { module_type : @local::INPUT_MODULE }
physics                                 : { @table::Mu2eII.physics }
physics.output_path                     : [ defaultOutput          ]
outputs.defaultOutput.SelectEvents      : [ @local::TRIGGER_PATH   ]
#------------------------------------------------------------------------------
services.GeometryService.inputFile      : "Mu2eII/common/geom_baseline.txt"
services.TFileService.fileName          : "nts._USER_.rpce1s51b0.Mu2eII.001000_00000000.root"
outputs.defaultOutput.fileName          : "mcs._USER_.rpce1s51b0.Mu2eII.001000_00000000.art"
