# -*- mode:tcl -*-
# pure background frames with full (digi + mc) and detector (digi only) output streams
# add trigger path to digi generation
# original author: Dave Brown, LBNL
#------------------------------------------------------------------------------
BEGIN_PROLOG
  MIXER_READ_MODE         @protect_ignore: sequential   # randomReplace / sequential
  MIXER_MU2E_SKIP_FACTOR  @protect_ignore: 0            # default - 1 (JobConfig/mixing/prolog1.fcl)
  TRIGGER_PATHS           @protect_ignore: [ p1 ]
  END_PATHS               @protect_ignore: [ e1 ]
END_PROLOG

#include "JobConfig/common/Mu2eII.fcl" 

process_name: S4NoPrimary

services.message.destinations.log.categories.ArtReport.limit       : 10000  # number of events 

source  : { module_type : EmptyEvent }
outputs           : { @table::Mu2eII.outputs   }

physics : { 
    producers     : { @table::Mu2eII.producers @table::Mixing.producers }
    filters       : { @table::Mu2eII.filters   @table::Mixing.filters   }

    trigger_paths : [ @sequence::TRIGGER_PATHS ]
    end_paths     : [ @sequence::END_PATHS     ]                     # needed for generate_fcl
}
#------------------------------------------------------------------------------
# 1. paths
#------------------------------------------------------------------------------
physics.p1        : [ @sequence::Mixing.minbias_nocrv ] 
physics.e1        : [ DetOutput                       ]
#------------------------------------------------------------------------------
# beam intensity: 3.9e7 (2-batch mode) 1.6e7 (1-batch mode) SFD=0.6 (default)
#------------------------------------------------------------------------------
physics.producers.protonBunchIntensity.extendedMean :  1.6e7  # <mean> of the unconstrained distribution
#-------------------------------------------------------------------------------------------------------
# debug printouts : want to print number of mixed events
#------------------------------------------------------------------------------
# physics.filters.flashMixerTrkCal.mu2e.debugLevel                  : 1
# physics.filters.ootMixerTrkCal.mu2e.debugLevel                    : 1
# physics.filters.neutronMixerTrkCal.mu2e.debugLevel                : 1
# physics.filters.dioMixerTrkCal.mu2e.debugLevel                    : 1
# physics.filters.photonMixerTrkCal.mu2e.debugLevel                 : 1
# physics.filters.protonMixerTrkCal.mu2e.debugLevel                 : 1
# physics.filters.deuteronMixerTrkCal.mu2e.debugLevel               : 1
#------------------------------------------------------------------------------
# input maps from prirmaries and flash. these get used first, new times are only generated for mu-daughter backgrounds
# no primary in the time maps
#------------------------------------------------------------------------------
physics.producers.protonTimeMap.InputTimeMaps          : [ @sequence::Mixing.protonTimeMaps ]
physics.producers.muonTimeMap.InputTimeMaps            : [ ]
#------------------------------------------------------------------------------
# after flash time cut mix change
# don't include VD and IPA steps from flash: they just add bulk
# P.M. : resample flash after stage 3, thus the name "resamplingMixer"
#------------------------------------------------------------------------------
physics.filters.flashMixerTrkCal.mu2e.products.genParticleMixer   : { mixingMap: [ [ "resamplingMixer"                       , ""              ] ] }
physics.filters.flashMixerTrkCal.mu2e.products.simParticleMixer   : { mixingMap: [ [ "g4run"                                 , ""              ] ] }
physics.filters.flashMixerTrkCal.mu2e.products.protonTimeMapMixer : { mixingMap: [ [ "protonTimeMap"                         , "protonTimeMap" ] ] }
physics.filters.flashMixerTrkCal.mu2e.products.stepPointMCMixer   : { mixingMap: [ [ "g4run:tracker"                         , ":"             ] ] }

physics.filters.flashMixerTrkCal.mu2e.products.caloShowerStepMixer: { mixingMap: [ [ "CaloShowerStepFromStepPt:calorimeter"  , ":"             ] ,
										   [ "CaloShowerStepFromStepPt:calorimeterRO", ":"             ] ] }
# calo configuration
physics.producers.CaloShowerStepROFromShowerStep.caloCrystalShowerInputs     : [ "CaloShowerStepFromStepPt:calorimeter", 
										 @sequence::Mixing.caloMixerTags 
										]
#------------------------------------------------------------------------------
# redefinition of simParticleTags is neded, as Mixing.producers.compressDigiMCs, 
# defined in JobConfig/common/Mu2eII_mixing_templates.fcl, by default, also includes 
# "g4run" tag for primary particle
#------------------------------------------------------------------------------
physics.producers.compressDigiMCs.simParticleTags      : [ @sequence::Mixing.TrkCalMixSequence ] # [, @sequence::Mixing.CRVMixSequence ]
physics.producers.compressDigiMCs.extraStepPointMCTags : [ ]
physics.producers.compressDigiMCs.mcTrajectoryTag      : ""
physics.producers.compressDigiMCs.crvDigiMCTag         : ""     # no CRV
#------------------------------------------------------------------------------
# output files
#------------------------------------------------------------------------------
services.TFileService.fileName : "nts.user.mnbs0s41b1.Mu2eII.sequencer.root"
outputs.FullOutput.fileName    : "dig.user.mnbs0s41b1.Mu2eII.sequencer.art"
outputs.DetOutput.fileName     : "dig.user.mnbs0s41b1.Mu2eII.sequencer.art"

physics.filters.deuteronMixerTrkCal.fileNames   : ["/pnfs/mu2e/tape/phy-sim/sim/mu2e/deut0s41b0/Mu2eII/art/31/17/sim.mu2e.deut0s41b0.Mu2eII.001000_00000000.art"]
physics.filters.dioMixerTrkCal.fileNames        : ["/pnfs/mu2e/tape/phy-sim/sim/mu2e/dio00s41b0/Mu2eII/art/3f/53/sim.mu2e.dio00s41b0.Mu2eII.001000_00000000.art"]
physics.filters.neutronMixerTrkCal.fileNames    : ["/pnfs/mu2e/tape/phy-sim/sim/mu2e/neut0s41b0/Mu2eII/art/8b/73/sim.mu2e.neut0s41b0.Mu2eII.001000_00000000.art"]
physics.filters.ootMixerTrkCal.fileNames        : ["/pnfs/mu2e/tape/phy-sim/sim/mu2e/ootm0s41b0/Mu2eII/art/43/df/sim.mu2e.ootm0s41b0.Mu2eII.001000_00000000.art"]
physics.filters.photonMixerTrkCal.fileNames     : ["/pnfs/mu2e/tape/phy-sim/sim/mu2e/epho0s41b0/Mu2eII/art/21/df/sim.mu2e.epho0s41b0.Mu2eII.001000_00000000.art"]
physics.filters.protonMixerTrkCal.fileNames     : ["/pnfs/mu2e/tape/phy-sim/sim/mu2e/prot0s41b0/Mu2eII/art/43/c9/sim.mu2e.prot0s41b0.Mu2eII.001000_00000000.art"]
physics.filters.flashMixerTrkCal.fileNames      : ["/pnfs/mu2e/tape/phy-sim/sim/mu2e/flsh1s51b0/Mu2eII/art/87/d2/sim.mu2e.flsh1s51b0.Mu2eII.001000_00000000.art"]
# 
#include "gen/fcl/Trigger/offline/allTrig/allPaths.fcl"
