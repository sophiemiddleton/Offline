#
# mono-energetic e- at the V Ce endpoint without background mixing
#
# original author: Dave Brown, LBNL
#
#include "JobConfig/primary/prolog.fcl"
process_name: CeEndpoint  

source: { module_type : EmptyEvent }
services: @local::Services.Sim
physics : { 
  producers : {
    generate : @local::CeEndpointGunV 
    @table::Primary.producers
  }
  filters: { @table::Primary.filters }
  analyzers: { @table::Primary.analyzers }
  TriggerPath : @local::Primary.TriggerPath
  EndPath : @local::Primary.EndPath
}


outputs : { 
  Output :@local::Primary.Output
}
#
# final configuration
#
#include "JobConfig/primary/epilog.fcl"
# customize the output
physics.producers.generate.muonStops.inputFiles   :  ["JobConfig/Mu2eII/MuonStops_V_17.root"]
physics.producers.generate.muonStops.treeName  : "stoppedMuonDumper/stops;1"
physics.producers.generate.muonStops.branchName             : "stops"
physics.producers.generate.muonStops.verbosityLevel         : 1

services.TFileService.fileName: "nts.owner.CeEndpoint.version.sequencer.root"
outputs.Output.fileName: "dig.owner.CeEndpoint.version.sequencer.art"
physics.end_paths : [ EndPath ] # needed for generate_fcl


